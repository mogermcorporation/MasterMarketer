generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingSlot {
  id          String   @id @default(uuid())
  platform    String
  scheduledAt DateTime
  status      String   @default("queued")
  createdAt   DateTime @default(now())
}
